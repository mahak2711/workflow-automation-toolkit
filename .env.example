# LLM
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_CONCURRENCY=4
CELERY_RETRY_MAX=3
CELERY_RETRY_BACKOFF=60

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Gmail
GMAIL_CREDENTIALS=/secrets/gmail-sa.json

# S3 (for report output)
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=workflow-reports

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me
